set -e

# Keep this hook fast (seconds, not minutes). The full build and every
# package's test suite run in CI (.github/workflows/unit-tests.yml), which
# branch protection requires before merge.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found. Install with: brew install gitleaks"
  exit 1
fi
gitleaks protect --staged --verbose --redact

# Format staged files and re-stage them, so formatting never accumulates into
# unrelated diffs.
pnpm exec lint-staged

# Type-check only the packages/apps that have staged changes. Dependencies are
# type-checked against their built dist/*.d.ts, so if this fails right after a
# pull, run `pnpm -r --filter './packages/**' build` once.
for dir in $(git diff --cached --name-only --diff-filter=ACMR \
    | sed -nE 's#^((packages|apps)/[^/]+)/.*#\1#p' | sort -u); do
  if [ -f "$dir/tsconfig.json" ] && [ "$dir" != "packages/ui-widget" ]; then
    echo "Type-checking $dir"
    (cd "$dir" && pnpm exec tsc --noEmit)
  fi
done
