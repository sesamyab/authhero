# ============================================================================
# Development Environment Variables — WFP Tenant Worker
# ============================================================================
# Copy this file to .dev.vars and fill in your values.
# ============================================================================

# This tenant's own at-rest encryption key (base64-encoded 32 bytes).
# `create-authhero` writes a generated key here for local dev. In production:
#   wrangler secret put ENCRYPTION_KEY
# Generate one with: openssl rand -base64 32
# ENCRYPTION_KEY=

# The CONTROL PLANE key (key id "cp"). Decrypts the shared secrets the control
# plane synced into this tenant's database. Must be byte-identical to the
# control plane's CONTROL_PLANE_ENCRYPTION_KEY. In production, pass it with
# `wrangler deploy --secrets-file .dev.vars`.
# CONTROL_PLANE_ENCRYPTION_KEY=

# Bearer secret the control plane sends to /internal/sync-config. Must be
# identical to the control plane's WFP_INTERNAL_SYNC_SECRET, otherwise a sync
# answers 401.
# WFP_INTERNAL_SYNC_SECRET=
