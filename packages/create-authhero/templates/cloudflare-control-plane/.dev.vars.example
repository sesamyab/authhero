# ============================================================================
# Development Environment Variables — Control Plane Worker
# ============================================================================
# Copy this file to .dev.vars and fill in your values.
# ============================================================================

# The control plane's own at-rest encryption key (base64-encoded 32 bytes).
# `create-authhero` writes a generated key here for local dev. In production:
#   wrangler secret put ENCRYPTION_KEY
# Generate one with: openssl rand -base64 32
# ENCRYPTION_KEY=

# The shared CONTROL PLANE key (key id "cp"). The control plane tenant's secrets
# are encrypted under it, and a sync copies that ciphertext into each tenant's
# database; each tenant Worker holds the same key to decrypt it. Must be
# byte-identical across the control plane and every tenant Worker.
#   wrangler secret put CONTROL_PLANE_ENCRYPTION_KEY
# CONTROL_PLANE_ENCRYPTION_KEY=

# Bearer secret for the sync push to a tenant Worker's /internal/sync-config.
# Must be identical on the control plane and every tenant Worker (else 401).
#   wrangler secret put WFP_INTERNAL_SYNC_SECRET
# WFP_INTERNAL_SYNC_SECRET=
